 {
  "id": "cl-quantifiers",
  "label": "Quantifiers & Venn Diagrams",
  "branch": "CL",
  "parent": "br-cl",
  "kind": "cl",
  "icon": "quantifier",
  "chapter": "CHAPTER IV — QUANTIFIERS",
  "week": 4,
  "lesson": true,
  "oneLiner": "All, most, some, none: each licenses different inferences.",
  "definition": "“All A are B” is a conditional. “Some” means at least one. “Most” means more than half. Most + all chains forward; most + most yields “some” only when both concern the same group.",
  "objectives": [
   "Draw Venn diagrams for quantified statements",
   "Combine quantifiers validly"
  ],
  "examples": [
   {
    "domain": "Everyday",
    "text": "All cats are mammals; some mammals swim—nothing follows about cats swimming."
   },
   {
    "domain": "Law",
    "text": "Most judges were arbitrators; all arbitrators favor the rules → most judges favor the rules."
   },
   {
    "domain": "Business & Finance",
    "text": "Most bonds are IG; all IG are euro → most bonds are euro."
   }
  ],
  "attack": [
   "Translate each statement (all → arrow; some → overlap ✕; none → shaded)",
   "Draw the Venn",
   "Chain all/most forward",
   "Use “most + most of the same group → some overlap”"
  ],
  "correctLooksLike": "An inference you can see on the Venn diagram.",
  "traps": [
   "Most + most of different groups",
   "Treating “some” as “some not”",
   "Running “most” backward"
  ],
  "commonError": "Assuming “some A are B” implies “some A are not B.”",
  "keyPoints": [
   {
    "point": "All = conditional",
    "keywords": [
     "all",
     "conditional"
    ]
   },
   {
    "point": "Some = at least one",
    "keywords": [
     "some",
     "at least one"
    ]
   },
   {
    "point": "Most = more than half",
    "keywords": [
     "most",
     "half"
    ]
   },
   {
    "point": "Most + all chains forward",
    "keywords": [
     "chain",
     "forward"
    ]
   }
  ],
  "mindMap": {
   "label": "Quantifiers & Venn Diagrams",
   "children": [
    {
     "label": "All",
     "children": [
      {
       "label": "A → B"
      },
      {
       "label": "Shade A outside B"
      }
     ]
    },
    {
