 {
  "id": "cl-contrapositive",
  "label": "The Contrapositive",
  "branch": "CL",
  "parent": "br-cl",
  "kind": "cl",
  "icon": "contrapositive",
  "chapter": "CHAPTER IV — THE CONTRAPOSITIVE",
  "week": 3,
  "lesson": true,
  "oneLiner": "Flip and negate: A → B is equivalent to ¬B → ¬A.",
  "definition": "The contrapositive is the only valid transformation of a conditional. Reverse the order and negate both sides.",
  "objectives": [
   "Form contrapositives instantly",
   "Use them to derive inferences in MBT and SA questions"
  ],
  "examples": [
   {
    "domain": "Everyday",
    "text": "If it’s a dog, it’s a mammal → if it’s not a mammal, it’s not a dog."
   },
   {
    "domain": "Law",
    "text": "If ratified, binding → if not binding, not ratified."
   },
   {
    "domain": "Business & Finance",
    "text": "If audited, never defaulted → if defaulted, not audited."
   }
  ],
  "attack": [
   "Write A → B",
   "Reverse: B ? A",
   "Negate both: ¬B → ¬A",
   "For “and/or” in a side, flip and/or when negating"
  ],
  "correctLooksLike": "The original conditional, flipped and negated.",
  "traps": [
   "Flipping without negating (reversal)",
   "Negating without flipping (negation)"
  ],
  "commonError": "Forgetting to switch “and” to “or” when negating a compound condition.",
  "keyPoints": [
   {
    "point": "Flip and negate",
    "keywords": [
     "flip",
     "negate"
    ]
   },
   {
    "point": "Only valid transformation",
    "keywords": [
     "valid",
     "only"
    ]
   },
   {
    "point": "And ↔ or when negating",
    "keywords": [
     "and",
     "or"
    ]
   }
  ],
  "mindMap": {
   "label": "The Contrapositive",
   "children": [
    {
     "label": "Original",
     "children": [
      {
       "label": "A → B"
      }
     ]
    },
    {
     "label": "Contrapositive",
     "children": [
      {
       "label": "¬B → ¬A"
      }
     ]
    },
    {
     "label": "Invalid",
     "children": [
      {
       "label": "B → A"
      },
      {
       "label": "¬A → ¬B"
      }
     ]
    },
    {
     "label": "Compound",
     "children": [
      {
       "label": "and ↔ or"
      }
     ]
    }
   ]
  },
  "links": [
   "cl-suff-nec",
   "lr-must-be-true",
   "lr-cannot-be-true"
  ],
  "card": {
   "front": "Contrapositive of: Signed → (Approved AND Published)?",
   "back": "(¬Approved OR ¬Published) → ¬Signed.",
   "keywords": [
    "or",
    "not signed"
   ]
  },
  "match": {
   "patterns": [
    "conditional"
   ]
  }
