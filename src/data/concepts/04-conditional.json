 {
  "id": "cl-chaining",
  "label": "Chaining Conditionals",
  "branch": "CL",
  "parent": "br-cl",
  "kind": "cl",
  "icon": "chain",
  "chapter": "CHAPTER V — CHAINING",
  "week": 5,
  "lesson": true,
  "oneLiner": "Link A → B and B → C into A → C—and its contrapositive.",
  "definition": "When the necessary condition of one statement is the sufficient condition of another, they chain. Chains of 3–5 links power hard Must Be True and Sufficient Assumption questions.",
  "objectives": [
   "Order scattered conditionals into a chain",
   "Read off every valid inference",
   "Spot missing links (for SA)"
  ],
  "examples": [
   {
    "domain": "Everyday",
    "text": "Coffee → awake → productive: coffee → productive."
   },
   {
    "domain": "Law",
    "text": "Enforced → recognized → not one-party appointed."
   },
   {
    "domain": "Business & Finance",
    "text": "Signed 2010+ → arbitration clause → bypass courts."
   }
  ],
  "attack": [
   "Translate every statement",
   "Find a term that appears as a necessary in one and sufficient in another",
   "Link and extend",
   "Write the long contrapositive",
   "For SA: find the gap in the chain"
  ],
  "correctLooksLike": "A single chain with its contrapositive, from which inferences are read directly.",
  "traps": [
