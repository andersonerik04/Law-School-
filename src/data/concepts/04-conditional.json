 {
  "id": "cl-suff-nec",
  "label": "Sufficient & Necessary",
  "branch": "CL",
  "parent": "br-cl",
  "kind": "cl",
  "icon": "cl",
  "chapter": "CHAPTER IV — SUFFICIENT & NECESSARY",
  "week": 3,
  "lesson": true,
  "oneLiner": "A sufficient condition guarantees; a necessary condition is required.",
  "definition": "“If A, then B” makes A sufficient for B and B necessary for A. Knowing A tells you B; knowing B tells you nothing about A.",
  "objectives": [
   "Translate conditional statements into arrows",
   "Identify sufficient vs. necessary conditions",
   "Spot reversals"
  ],
  "examples": [
   {
    "domain": "Everyday",
    "text": "If it is raining, the ground is wet: rain is sufficient; wet ground is necessary."
   },
   {
    "domain": "Law",
    "text": "A bill becomes law only if signed: signature is necessary, not sufficient."
   },
   {
    "domain": "Business & Finance",
    "text": "Investment-grade only if rated BBB− or higher: the rating is necessary."
   }
  ],
  "attack": [
   "Find the indicator (if, only if, all, requires)",
   "Write sufficient → necessary",
   "Check: does the sufficient guarantee the necessary?",
   "Never run the arrow backward"
  ],
  "correctLooksLike": "An arrow from the guaranteeing condition to the required one.",
  "traps": [
   "Reversal",
   "Treating necessary as sufficient"
  ],
  "commonError": "Reading “only if” as “if.”",
  "keyPoints": [
   {
    "point": "Sufficient guarantees",
    "keywords": [
     "sufficient",
     "guarantee"
    ]
   },
   {
    "point": "Necessary is required",
    "keywords": [
     "necessary",
     "required"
    ]
   },
   {
    "point": "Arrow runs sufficient → necessary",
    "keywords": [
     "arrow"
    ]
   },
   {
    "point": "“Only if” introduces the necessary",
    "keywords": [
     "only if"
    ]
   }
  ],
  "mindMap": {
   "label": "Sufficient & Necessary",
   "children": [
